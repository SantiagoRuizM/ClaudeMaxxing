{
  "manifest_version": 3,
  "name": "ClaudeMaxxing",
  "version": "0.2.0",
  "description": "El ambiente encendido, el uso del plan y lo que se sale de foco, con un aviso al navegar. Le da a ClaudeMaxxing tus pestañas.",
  "key": "",
  "action": {
    "default_title": "ClaudeMaxxing",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "alarms",
    "identity",
    "identity.email",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "ClaudeMaxxing",
  "version": "0.2.0",
  "description": "El ambiente encendido, el uso del plan y lo que se sale de foco, con un aviso al navegar. Le da a ClaudeMaxxing tus pestañas.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "ClaudeMaxxing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "alarms",
    "identity",
    "identity.email",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}

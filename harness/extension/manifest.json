{
  "manifest_version": 3,
  "name": "YourHarness",
  "version": "0.1.0",
  "description": "Exposes open tabs (title, URL, page content) to the local YourHarness CLI and closes them on request.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "nativeMessaging", "alarms", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}

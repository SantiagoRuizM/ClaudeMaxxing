# Claude app icons: install.ps1 copies them from the installed Claude app into the install folder
/assets/
*.stackdump
.claude/settings.local.json
# Explorer menu: bin/ holds the prebuilt DLL, stub and unsigned MSIX (committed); only build leftovers are ignored
/menu/bin/*.obj
/menu/bin/*.exp
/menu/bin/*.lib
/menu/bin/*.cer
# Generated by voice/install.ps1 (global /voz) and install.ps1 (plugin /voz); per-PC voice settings
/voice/.claude/
/voice/plugin/skills/
/voice/config.local.json
/voice/venv/
